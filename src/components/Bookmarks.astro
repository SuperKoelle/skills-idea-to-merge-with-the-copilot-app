---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<p id="bookmark-status" role="status" aria-live="polite"></p>

<script>
  import { createSlug, formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const bookmarkList = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');
  const clearAll = document.getElementById('clear-all');
  let bookmarks: ReturnType<typeof loadBookmarks> = [];

  function showStatus(message: string) {
    if (status) status.textContent = message;
  }

  function renderBookmarks() {
    if (!bookmarkList || !emptyState || !listHeader) return;

    bookmarkList.replaceChildren();
    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.dataset.slug = bookmark.slug;
      copyButton.textContent = 'Copy';

      row.append(link, separator, slug, copyButton);
      bookmarkList.append(row);
    }

    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;
  }

  function saveBookmarks(nextBookmarks: typeof bookmarks): boolean {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      bookmarks = nextBookmarks;
      renderBookmarks();
      return true;
    } catch {
      showStatus('Bookmarks could not be saved in this browser.');
      return false;
    }
  }

  try {
    bookmarks = loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
  } catch {
    showStatus('Bookmarks could not be loaded from this browser.');
  }
  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const normalizedUrl = normalizeUrl(urlInput?.value ?? '');
    if (!normalizedUrl) {
      showStatus('Enter a valid web address to save a bookmark.');
      urlInput?.focus();
      return;
    }

    const bookmark = { url: normalizedUrl, slug: createSlug(bookmarks) };
    if (saveBookmarks([...bookmarks, bookmark])) {
      if (urlInput) urlInput.value = '';
      showStatus(`Saved ${formatBookmark(bookmark)}`);
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;

    try {
      window.localStorage.removeItem(STORAGE_KEY);
      bookmarks = [];
      renderBookmarks();
      showStatus('All bookmarks cleared.');
    } catch {
      showStatus('Bookmarks could not be cleared from this browser.');
    }
  });

  bookmarkList?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement) || !target.dataset.slug) return;

    try {
      await navigator.clipboard.writeText(target.dataset.slug);
      showStatus(`Copied ${target.dataset.slug}.`);
    } catch {
      showStatus('The slug could not be copied.');
    }
  });
</script>
